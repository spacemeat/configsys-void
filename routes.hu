{
    // Make Void Linux a first-class OS. xbps is its native package manager, and Void ships in TWO
    // flavors that differ only by C library — a clean demo that libc is an axis ORTHOGONAL to the
    // distro/package-manager:
    //   void       — glibc (hangs off `glibc_linux`, so it PROVIDES `glibc`): AppImages and glibc
    //                tarballs (neovim, julia, deno, ...) install normally.
    //   void_musl  — musl (hangs off bare `linux`, like Alpine): those same glibc-only bindings
    //                `requires: glibc` and cleanly DECLINE — no per-component work; same xbps
    //                driver, same component-names, just a different binary-compat surface.
    // Both report ID=void, so void_musl is told apart by the musl loader's presence (detect:
    // marker) — the data-driven mechanism, no code. (x86_64 loader path; configsys targets x86_64.)
    os: {
        void:      { using: glibc_linux  native: xbps }
        void_musl: { using: linux        native: xbps
                     detect: { id: void  marker: /lib/ld-musl-x86_64.so.1 } }
    }

    // Void-specific components, installed with the xbps driver this plugin ships. Guarded to both
    // Void flavors (they're siblings — different libc parents — so `void` alone wouldn't match
    // void_musl). `via: xbps` is the direct form (packages unique to this distro); repo components
    // keep using `via: native`, which resolves to xbps on both flavors.
    components: {
        xtools: { install: [ { via: xbps  when: "void or void_musl" } ] }   // Void's packaging helper scripts
    }

    // Per-driver package-name patches for CORE components whose xbps name differs from the
    // generic default — supplied WITHOUT redefining the component (that's what `component-names`
    // is for). xbps names are libc-agnostic, so this one map covers BOTH flavors; verified against
    // void-glibc AND void-musl by test/run-name-sweep.sh, which keeps it honest as Void's repos
    // roll. `{}` = Void has no xbps package for the component, so it's simply not offered here
    // (rocm-hip: Void doesn't package AMD's ROCm).
    //
    // Void is now ALSO in configsys core, which carries these same facts as `xbps:` entries in each
    // binding's `name:` map (plus Void-only bindings this map can't express); core is authoritative.
    // test/test_parity.py checks that nothing here contradicts it.
    component-names: {
        xbps: {
            docker-engine: docker          // "Docker container runtime" (default was docker.io)
            fish:          fish-shell
            jdk:           openjdk21        // Void versions the JDK; 21 is current LTS
            libfuse2:      fuse             // FUSE2 runtime (libfuse.so.2)
            maven:         apache-maven
            netcat:        openbsd-netcat   // the BSD nc
            pipx:          python3-pipx
            r:             R                // capital R
            tshark:        wireshark        // tshark ships inside the wireshark package
            rocm-hip:      {}               // no ROCm on Void -> not offered
        }
    }
}
