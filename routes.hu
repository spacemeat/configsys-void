{
    // Make Void Linux a first-class OS. It inherits the `linux` baseline and declares xbps as
    // its native package manager. This one block is enough that EVERY existing repo component
    // routed `via: native` (btop, ripgrep, firefox, ...) now installs on Void through the
    // xbps driver — no per-component work.
    os: {
        void: { using: linux  native: xbps }
    }

    // Void-specific components, installed with the xbps driver this plugin ships. Each is
    // guarded `when: "void"` so the binding exists ONLY where xbps does — a component is
    // never offered on an OS whose driver isn't loaded. `via: xbps` is the direct form (use
    // it for packages unique to this distro); repo components can keep using `via: native`.
    components: {
        xtools: { install: [ { via: xbps  when: "void" } ] }        // Void's packaging helper scripts
    }

    // Per-driver package-name patches for CORE components whose xbps name differs from the
    // generic default — supplied WITHOUT redefining the component (that's what `component-names`
    // is for). Verified against ghcr.io/void-linux/void-glibc by test/run-name-sweep.sh; the
    // sweep is what keeps this honest as Void's repos roll. `{}` = Void has no xbps package for
    // the component, so it's simply not offered here (nmap: only masscan is packaged).
    component-names: {
        xbps: {
            docker-engine: docker          // "Docker container runtime" (default was docker.io)
            fish:          fish-shell
            jdk:           openjdk21        // Void versions the JDK; 21 is current LTS
            libfuse2:      fuse             // FUSE2 runtime (libfuse.so.2)
            maven:         apache-maven
            netcat:        openbsd-netcat   // the BSD nc
            pipx:          python3-pipx
            r:             R                // capital R
            tshark:        wireshark        // tshark ships inside the wireshark package
            nmap:          {}               // absent on Void (only masscan) -> not offered
        }
    }
}
